# --- App ---
NODE_ENV=development
# Local dev server port (used by `pnpm dev`)
PORT=9003

# Version string shown in the UI (e.g. footer/about); "dev" locally, set to the
# release tag in CI/production builds
NEXT_PUBLIC_APP_VERSION=dev
# Support/contact email surfaced in the UI. Required — the build fails without it
# (see REQUIRED_ENV_VARS in next.config.js).
NEXT_PUBLIC_CONTACT_EMAIL=

# --- Backend API ---
# API version segment used to compute the backend base URL (see getBackendBaseUrl()
# in src/lib/site-urls.ts). Required unless NEXT_PUBLIC_BACKEND_BASE_URL is set.
NEXT_PUBLIC_HTMT_API_ROOT_SEGMENT=v2
# Optional explicit override for the backend base URL (bypasses the root-segment
# computation above) — useful for pointing at a local/remote API preset.
# NEXT_PUBLIC_BACKEND_BASE_URL=

# --- Sentry ---
# Enables Sentry error/perf monitoring at runtime (src/lib/sentry.js). Leave false locally.
NEXT_PUBLIC_SENTRY_IS_ACTIVE=false
NEXT_PUBLIC_SENTRY_DSN=
# Sampling rates (0.0-1.0) for traces and session replay; default to Sentry's own
# defaults if unset.
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=
# NEXT_PUBLIC_SENTRY_REPLAY_SESSION_SAMPLE_RATE=
# NEXT_PUBLIC_SENTRY_REPLAY_ON_ERROR_SAMPLE_RATE=

# --- Spotify OAuth ---
NEXT_PUBLIC_SPOTIFY_AUTH_URL=https://accounts.spotify.com/authorize
# Required. Register an app at https://developer.spotify.com/dashboard to get a client ID.
NEXT_PUBLIC_SPOTIFY_CLIENT_ID=
# Required. Must match a redirect URI registered on the Spotify app.
NEXT_PUBLIC_SPOTIFY_REDIRECT_URI=/auth/spotify/callback
# Required. Space-separated OAuth scopes requested at login.
NEXT_PUBLIC_SPOTIFY_SCOPES=user-read-email playlist-read-private playlist-read-collaborative user-library-read user-top-read

# --- Google OAuth ---
# Required. Register an app in Google Cloud Console to get a client ID.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Required. Must match a redirect URI registered on the Google OAuth client.
NEXT_PUBLIC_GOOGLE_REDIRECT_URI=/auth/google/callback
# Optional; code falls back to sensible defaults if unset.
# NEXT_PUBLIC_GOOGLE_AUTH_URL=
# NEXT_PUBLIC_GOOGLE_SCOPES=

# --- Uploads ---
# Required. Client-side upload timeout in milliseconds.
NEXT_PUBLIC_TRACK_UPLOAD_TIMEOUT_MS=300000
